/**
 * @file Firebase Security Rules for MinuteMind Application
 *
 * @corePhilosophy This ruleset enforces a strict user-ownership model. Only the authenticated user can access and modify data associated with their userId.
 * @dataStructure All data is nested under /users/{userId}, creating a clear ownership hierarchy.  Meetings, Minutes of Meeting, and Templates are stored in user-specific subcollections.
 * @keySecurityDecisions
 *   - User listing is disallowed to protect privacy.
 *   - All write operations require authentication.
 *   - Data validation is limited to ownership checks for relational integrity during `create` and immutability during `update`.
 *   - No `get()` calls are used for authorization, ensuring efficient rule execution.
 */
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    /**
     * @description Manages user profile data.
     * @path /users/{userId}
     * @allow (create) - User with UID 'dNeA9CQJSHW8jr1IXs5WfnhtSpl2' can create their own profile at /users/dNeA9CQJSHW8jr1IXs5WfnhtSpl2.
     * @allow (update) - User with UID 'dNeA9CQJSHW8jr1IXs5WfnhtSpl2' can update their own profile at /users/dNeA9CQJSHW8jr1IXs5WfnhtSpl2.
     * @allow (get) - User with UID 'dNeA9CQJSHW8jr1IXs5WfnhtSpl2' can get their own profile at /users/dNeA9CQJSHW8jr1IXs5WfnhtSpl2.
     * @deny (create) - User with UID 'attackerUID' cannot create a profile for /users/dNeA9CQJSHW8jr1IXs5WfnhtSpl2.
     * @deny (update) - User with UID 'attackerUID' cannot update the profile at /users/dNeA9CQJSHW8jr1IXs5WfnhtSpl2.
     * @deny (delete) - User with UID 'attackerUID' cannot delete the profile at /users/dNeA9CQJSHW8jr1IXs5WfnhtSpl2.
     * @deny (list) - Listing all users is not permitted.
     * @principle Enforces document ownership for writes and restricts access to a user's own data tree.
     */
    match /users/{userId} {
      allow get: if isOwner(userId);
      allow list: if false;
      allow create: if isSignedIn() && isOwner(userId) && request.resource.data.id == userId;
      allow update: if isSignedIn() && isExistingOwner(userId) && request.resource.data.id == resource.data.id;
      allow delete: if isSignedIn() && isExistingOwner(userId);
    }

    /**
     * @description Manages meeting data for a specific user.
     * @path /users/{userId}/meetings/{meetingId}
     * @allow (create) - User with UID 'dNeA9CQJSHW8jr1IXs5WfnhtSpl2' can create a meeting under their profile.
     * @allow (update) - User with UID 'dNeA9CQJSHW8jr1IXs5WfnhtSpl2' can update a meeting under their profile.
     * @allow (get) - User with UID 'dNeA9CQJSHW8jr1IXs5WfnhtSpl2' can get a meeting under their profile.
     * @allow (list) - User with UID 'dNeA9CQJSHW8jr1IXs5WfnhtSpl2' can list all their meetings.
     * @deny (create) - User with UID 'attackerUID' cannot create a meeting for user 'dNeA9CQJSHW8jr1IXs5WfnhtSpl2'.
     * @deny (update) - User with UID 'attackerUID' cannot update a meeting for user 'dNeA9CQJSHW8jr1IXs5WfnhtSpl2'.
     * @deny (delete) - User with UID 'attackerUID' cannot delete a meeting for user 'dNeA9CQJSHW8jr1IXs5WfnhtSpl2'.
     * @principle Enforces document ownership for writes and restricts access to a user's own data tree.
     */
    match /users/{userId}/meetings/{meetingId} {
      allow get: if isOwner(userId);
      allow list: if isOwner(userId);
      allow create: if isSignedIn() && isOwner(userId) && request.resource.data.userId == userId;
      allow update: if isSignedIn() && isExistingOwner(userId) && request.resource.data.userId == resource.data.userId;
      allow delete: if isSignedIn() && isExistingOwner(userId);
    }

    /**
     * @description Manages Minutes of Meeting (MoM) data for a specific meeting.
     * @path /users/{userId}/meetings/{meetingId}/minutesOfMeeting/{momId}
     * @allow (create) - User with UID 'dNeA9CQJSHW8jr1IXs5WfnhtSpl2' can create a MoM for their meeting.
     * @allow (update) - User with UID 'dNeA9CQJSHW8jr1IXs5WfnhtSpl2' can update a MoM for their meeting.
     * @allow (get) - User with UID 'dNeA9CQJSHW8jr1IXs5WfnhtSpl2' can get a MoM for their meeting.
     * @allow (list) - User with UID 'dNeA9CQJSHW8jr1IXs5WfnhtSpl2' can list all MoMs for their meeting.
     * @deny (create) - User with UID 'attackerUID' cannot create a MoM for user 'dNeA9CQJSHW8jr1IXs5WfnhtSpl2'.
     * @deny (update) - User with UID 'attackerUID' cannot update a MoM for user 'dNeA9CQJSHW8jr1IXs5WfnhtSpl2'.
     * @deny (delete) - User with UID 'attackerUID' cannot delete a MoM for user 'dNeA9CQJSHW8jr1IXs5WfnhtSpl2'.
     * @principle Enforces document ownership for writes and restricts access to a user's own data tree.
     */
    match /users/{userId}/meetings/{meetingId}/minutesOfMeeting/{momId} {
      allow get: if isOwner(userId);
      allow list: if isOwner(userId);
      allow create: if isSignedIn() && isOwner(userId);
      allow update: if isSignedIn() && isExistingOwner(userId);
      allow delete: if isSignedIn() && isExistingOwner(userId);
    }

    /**
     * @description Manages templates created by a specific user.
     * @path /users/{userId}/templates/{templateId}
     * @allow (create) - User with UID 'dNeA9CQJSHW8jr1IXs5WfnhtSpl2' can create a template under their profile.
     * @allow (update) - User with UID 'dNeA9CQJSHW8jr1IXs5WfnhtSpl2' can update a template under their profile.
     * @allow (get) - User with UID 'dNeA9CQJSHW8jr1IXs5WfnhtSpl2' can get a template under their profile.
     * @allow (list) - User with UID 'dNeA9CQJSHW8jr1IXs5WfnhtSpl2' can list all their templates.
     * @deny (create) - User with UID 'attackerUID' cannot create a template for user 'dNeA9CQJSHW8jr1IXs5WfnhtSpl2'.
     * @deny (update) - User with UID 'attackerUID' cannot update a template for user 'dNeA9CQJSHW8jr1IXs5WfnhtSpl2'.
     * @deny (delete) - User with UID 'attackerUID' cannot delete a template for user 'dNeA9CQJSHW8jr1IXs5WfnhtSpl2'.
     * @principle Enforces document ownership for writes and restricts access to a user's own data tree.
     */
    match /users/{userId}/templates/{templateId} {
      allow get: if isOwner(userId);
      allow list: if isOwner(userId);
      allow create: if isSignedIn() && isOwner(userId) && request.resource.data.userId == userId;
      allow update: if isSignedIn() && isExistingOwner(userId) && request.resource.data.userId == resource.data.userId;
      allow delete: if isSignedIn() && isExistingOwner(userId);
    }
  }

  // Helper functions
  function isSignedIn() {
    return request.auth != null;
  }

  function isOwner(userId) {
    return request.auth.uid == userId;
  }

  function isExistingOwner(userId) {
    return isOwner(userId) && resource != null;
  }
}