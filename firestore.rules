/**
 * @fileOverview
 * This ruleset enforces a strict user-ownership model for all data.
 * All data is nested under /users/{userId}, ensuring that only the authenticated user can access their own data.
 *
 * Data Structure:
 * - /users/{userId}: Stores user profile information. Only the user can read/write their own profile.
 * - /users/{userId}/meetings/{meetingId}: Stores meeting data for a user. Only the user can read/write their meetings.
 * - /users/{userId}/meetings/{meetingId}/minutesOfMeeting/{momId}: Stores minutes of meeting data. Only the user can read/write.
 * - /users/{userId}/templates/{templateId}: Stores templates created by the user. Only the user can read/write their own templates.
 *
 * Key Security Decisions:
 * - User listing is disallowed to protect privacy.
 * - All write operations are strictly controlled via the isOwner() function, ensuring that only the authenticated user can modify data under their userId.
 * - Data validation is minimal in this prototyping phase, focusing only on ownership checks and relational integrity.
 */
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    /**
     * @description Controls access to user profile data.
     * @path /users/{userId}
     * @allow (create) User with UID 'user123' can create their profile at /users/user123.
     * @deny (create) User with UID 'user456' cannot create a profile at /users/user123.
     * @allow (update) User with UID 'user123' can update their profile at /users/user123.
     * @deny (update) User with UID 'user456' cannot update the profile at /users/user123.
     * @principle Enforces document ownership for all operations.
     */
    match /users/{userId} {
      // Helper function to check if the user is signed in
      function isSignedIn() {
        return request.auth != null;
      }

      // Helper function to check if the authenticated user is the owner of the document.
      function isOwner(userId) {
        return request.auth.uid == userId;
      }

      // Helper function to check if the authenticated user is the existing owner of the document.
      function isExistingOwner(userId) {
        return isOwner(userId) && resource != null;
      }

      allow get: if isOwner(userId);
      allow list: if false;

      allow create: if isSignedIn() && isOwner(userId);
      allow update: if isExistingOwner(userId);
      allow delete: if isExistingOwner(userId);
    }

    /**
     * @description Controls access to meeting data for a specific user.
     * @path /users/{userId}/meetings/{meetingId}
     * @allow (create) User 'user123' can create a meeting under /users/user123/meetings/meeting1.
     * @deny (create) User 'user456' cannot create a meeting under /users/user123/meetings/meeting1.
     * @allow (update) User 'user123' can update a meeting under /users/user123/meetings/meeting1.
     * @deny (update) User 'user456' cannot update a meeting under /users/user123/meetings/meeting1.
     * @principle Enforces document ownership for writes.
     */
    match /users/{userId}/meetings/{meetingId} {
      // Helper function to check if the user is signed in
      function isSignedIn() {
        return request.auth != null;
      }

      // Helper function to check if the authenticated user is the owner of the document.
      function isOwner(userId) {
        return request.auth.uid == userId;
      }

      // Helper function to check if the authenticated user is the existing owner of the document.
      function isExistingOwner(userId) {
        return isOwner(userId) && resource != null;
      }

      allow get: if isOwner(userId);
      allow list: if isOwner(userId);

      allow create: if isSignedIn() && isOwner(userId);
      allow update: if isExistingOwner(userId);
      allow delete: if isExistingOwner(userId);
    }

    /**
     * @description Controls access to Minutes of Meeting data for a specific meeting.
     * @path /users/{userId}/meetings/{meetingId}/minutesOfMeeting/{momId}
     * @allow (create) User 'user123' can create MoM data under /users/user123/meetings/meeting1/minutesOfMeeting/mom1.
     * @deny (create) User 'user456' cannot create MoM data under /users/user123/meetings/meeting1/minutesOfMeeting/mom1.
     * @allow (update) User 'user123' can update MoM data under /users/user123/meetings/meeting1/minutesOfMeeting/mom1.
     * @deny (update) User 'user456' cannot update MoM data under /users/user123/meetings/meeting1/minutesOfMeeting/mom1.
     * @principle Enforces document ownership for writes.
     */
    match /users/{userId}/meetings/{meetingId}/minutesOfMeeting/{momId} {
      // Helper function to check if the user is signed in
      function isSignedIn() {
        return request.auth != null;
      }

      // Helper function to check if the authenticated user is the owner of the document.
      function isOwner(userId) {
        return request.auth.uid == userId;
      }

      // Helper function to check if the authenticated user is the existing owner of the document.
      function isExistingOwner(userId) {
        return isOwner(userId) && resource != null;
      }

      allow get: if isOwner(userId);
      allow list: if isOwner(userId);

      allow create: if isSignedIn() && isOwner(userId);
      allow update: if isExistingOwner(userId);
      allow delete: if isExistingOwner(userId);
    }

    /**
     * @description Controls access to template data created by a specific user.
     * @path /users/{userId}/templates/{templateId}
     * @allow (create) User 'user123' can create a template under /users/user123/templates/template1.
     * @deny (create) User 'user456' cannot create a template under /users/user123/templates/template1.
     * @allow (update) User 'user123' can update a template under /users/user123/templates/template1.
     * @deny (update) User 'user456' cannot update a template under /users/user123/templates/template1.
     * @principle Enforces document ownership for writes.
     */
    match /users/{userId}/templates/{templateId} {
      // Helper function to check if the user is signed in
      function isSignedIn() {
        return request.auth != null;
      }

      // Helper function to check if the authenticated user is the owner of the document.
      function isOwner(userId) {
        return request.auth.uid == userId;
      }

      // Helper function to check if the authenticated user is the existing owner of the document.
      function isExistingOwner(userId) {
        return isOwner(userId) && resource != null;
      }

      allow get: if isOwner(userId);
      allow list: if isOwner(userId);

      allow create: if isSignedIn() && isOwner(userId);
      allow update: if isExistingOwner(userId);
      allow delete: if isExistingOwner(userId);
    }
  }
}